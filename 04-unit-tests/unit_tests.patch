+    // Regression characterization for https://github.com/delta-io/delta-kernel-rs/issues/1896.
+    #[test]
+    fn test_parse_schema_nesting_boundary() {
+        let metadata = |depth| Metadata {
+            schema_string: serde_json::to_string(&nested_schema(depth)).unwrap(),
+            ..Default::default()
+        };
+
+        metadata(41).parse_schema().unwrap();
+
+        let error = metadata(42).parse_schema().unwrap_err();
+        let error = match error {
+            Error::Backtraced { source, .. } => *source,
+            error => error,
+        };
+        match error {
+            Error::MalformedJson(error) => {
+                assert!(error.to_string().starts_with("recursion limit exceeded"));
+            }
+            error => panic!("expected a JSON recursion limit error, got {error:?}"),
+        }
+    }
+
+    fn nested_schema(depth: usize) -> StructType {
+        (0..depth).fold(
+            StructType::new_unchecked([StructField::nullable("leaf", DataType::INTEGER)]),
+            |schema, depth| {
+                StructType::new_unchecked([StructField::nullable(format!("level_{depth}"), schema)])
+            },
+        )
+    }
